# Copy to .env (git-ignored) and fill in. Never commit real values.

# FalkorDB (local: docker compose -f infra/docker-compose.yml up -d)
FALKORDB_URL=redis://localhost:6379

# GitHub read-only token for public data (optional locally: falls back to `gh auth token`)
GITHUB_TOKEN=

# LLM via OpenRouter (ADR-0009). Create a dedicated key with a credit limit.
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-5.5
EXTRACTION_MODEL=anthropic/claude-haiku-5.5
LLM_BUDGET_USD=12

# Fine-grained token limited to hineshmiyani/aevion-sandbox (Issues: read and write).
# The only credential Aevion writes to GitHub with (ADR-0005, ADR-0012).
SANDBOX_GITHUB_TOKEN=

# Signs webhook deliveries; paste the same value into the sandbox repo's webhook settings.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Shared by the API (PROXY_SECRET) and the web app (AEVION_PROXY_SECRET) so the API can trust
# the visitor IP the proxy forwards for rate limiting.
PROXY_SECRET=
# Browser origins allowed to call the API directly, as JSON.
CORS_ORIGINS=["http://localhost:3000"]

# Deploy only: the password for FalkorDB on Railway, used to load the graph through a
# temporary TCP proxy (docs/architecture/deployment.md). Not read by the app.
RAILWAY_FALKORDB_PASSWORD=
