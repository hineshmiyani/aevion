# Copy to .env (git-ignored) and fill in. Never commit real values.

# FalkorDB (local: docker compose -f infra/docker-compose.yml up -d)
FALKORDB_URL=redis://localhost:6379

# GitHub read-only token for public data (optional locally: falls back to `gh auth token`)
GITHUB_TOKEN=

# LLM via OpenRouter (ADR-0009). Create a dedicated key with a credit limit.
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-5.5
EXTRACTION_MODEL=anthropic/claude-haiku-5.5
LLM_BUDGET_USD=12
